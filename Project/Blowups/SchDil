variable (X) in
structure PreDilCent where
  (indnumb : Type u)

  (subschemeclo: indnumb → Scheme)
  (subschemepri: indnumb → Scheme)

  [over : ∀ (i : indnumb), Scheme.Over (subschemeclo i) X]
  [over : ∀ (i : indnumb), Scheme.Over (subschemepri i) X]

  cov : Scheme.AffineCover.{u, u} (P := @IsOpenImmersion) X
  idealclo: ∀ (_ : indnumb) (γ : cov.J), Ideal (cov.obj γ)
  idealpri: ∀ (_ : indnumb) (γ : cov.J), Ideal (cov.obj γ)
  genpri: ∀ (_ : indnumb) (γ : cov.J), elem \in Ideal (cov.obj γ)
  -- following is condition saying idealpri is principal (generated by elem of genpri)
  idealpricond : ∀ (_ : indnumb) (γ : cov.J), Ideal (cov.obj γ)=ideal.span (elem γ)
  condisoclo : ∀ (i : indnumb) (γ : cov.J),
    Spec (CommRingCat.of (cov.obj γ ⧸ idealclo i γ)) ≅
    pullback (f := subschemeclo i ↘ X) (g := cov.map γ)
  condisopri : ∀ (i : indnumb) (γ : cov.J),
    Spec (CommRingCat.of (cov.obj γ ⧸ idealpri i γ)) ≅
    pullback (f := subschemepri i ↘ X) (g := cov.map γ)
  condoverclo : ∀ (i : indnumb) (γ : cov.J),
    Scheme.Hom.IsOver (condisoclo i γ).hom
      (Spec (CommRingCat.of (cov.obj γ)))
  condoverpri : ∀ (i : indnumb) (γ : cov.J),
    Scheme.Hom.IsOver (condisopri i γ).hom
      (Spec (CommRingCat.of (cov.obj γ)))



lemma PreDilCent.index_eq_triangle {X : Scheme} (F: PreDilCent X) (i j : F.indnumb) (eq : i = j) :
    Scheme.Hom.IsOver (eqToHom (by rw [eq]) : F.subschemeclo i ⟶ F.subschemeclo j) X := by
  subst eq
  simp

lemma PreDiletCent.index_eq_triangle {X : Scheme} (F: PreDilCent X) (i j : F.indnumb) (eq : i = j) :
    Scheme.Hom.IsOver (eqToHom (by rw [eq]) : F.subschemepri i ⟶ F.subschemepri j) X := by
  subst eq
  simp



