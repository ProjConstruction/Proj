  subst eq
  simp

lemma PreClos.index_eq_triangle {X : Scheme} (F: PreDilCent X) (i j : F.indnumb) (eq : i = j) :
    Scheme.Hom.IsOver (eqToHom (by rw [eq]) : F.subschemepri i ⟶ F.subschemepri j) X := by
  subst eq
  simp



