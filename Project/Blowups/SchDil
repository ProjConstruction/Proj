lemma Dil_loc_pair_open (X: Scheme) (F: PreDilCent X) (γ δ : F.cov.J)
  (C : CommRingCat) (i : Spec C ⟶ open_pair X F γ δ) [IsOpenImmersion i]
  [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))] :
  ∃! (φ : pullback i (Dil_loc_pair_mor X F γ δ) ⟶
      pullback i (Dil_loc_pair_mor X F δ γ ≫ (pullbackSymmetry _ _).hom)),
      Scheme.Hom.IsOver φ (Spec C) := by sorry
  --  because it is an iso byy base_change_Bl_open

def Dil_loc_pair_open_φ (X: Scheme) (F: PreDilCent X)(γ δ : F.cov.J)
  (C : CommRingCat) (i : Spec C ⟶ open_pair X F γ δ) [IsOpenImmersion i]
  [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))] :
    pullback i (Dil_loc_pair_mor X F γ δ) ⟶
      pullback i (Dil_loc_pair_mor X F δ γ ≫ (pullbackSymmetry _ _).hom) :=
  Classical.choose (Dil_loc_pair_open X F γ δ C i)

lemma Dil_loc_pair_open_φ_isOver (X: Scheme) (F: PreDilCent X) (γ δ : F.cov.J)
  (C : CommRingCat) (i : Spec C ⟶ open_pair X F γ δ) [IsOpenImmersion i]
  [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))] :
    Scheme.Hom.IsOver (Dil__loc_pair_open_φ X F γ δ C i) (Spec C) :=
  Classical.choose_spec (Dil__loc_pair_open X F γ δ C i) |>.1

lemma Dil_loc_pair_open_φ_uniq (X: Scheme) (F: PreDilCent X) (γ δ : F.cov.J)
  (C : CommRingCat) (i : Spec C ⟶ open_pair X F γ δ) [IsOpenImmersion i]
  [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))] :
    ∀ φ' : pullback i (Dil_loc_pair_mor X F γ δ) ⟶
      pullback i (Dil_loc_pair_mor X F δ γ ≫ (pullbackSymmetry _ _).hom),
      Scheme.Hom.IsOver φ' (Spec C) → φ' = Dil_loc_pair_open_φ X F γ δ C i :=
  Classical.choose_spec (Dil_loc_pair_open X F γ δ C i) |>.2


def Dil_loc_pair_lemm (X: Scheme) (F: PreDilCent X) (γ δ : F.cov.J)
  [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))]:
  ∃! (f : (Dil_loc_pair X F γ δ) ⟶  (Dil_loc_pair X F δ γ)),

  (∃ (pf : Scheme.Hom.IsOver f (open_pair X F γ δ)),
    ∀ (C : CommRingCat) (i : Spec C ⟶ open_pair X F γ δ) [IsOpenImmersion i],
      restrictToOpen f i =
      (pullbackSymmetry _ _).hom ≫ Dil_loc_pair_open_φ X F γ δ C i ≫
      (pullbackSymmetry _ _).hom) := sorry
  --   restriction of f
  --  to U is given byy Dil_loc_pair_open X F γ δ U := by
  --   because it is an iso byy base_change_Dilopen
    -- sorry

def Dil_loc_pair_swap (X: Scheme) (F:PreDilCent X)(γ δ : F.cov.J)
  [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))] :
    (Dil_loc_pair X F γ δ) ⟶  (Dil_loc_pair X F δ γ) :=
  Classical.choose (Dil_loc_pair_lemm X F γ δ)

instance Dil_loc_pair_swap_isOver (X: Scheme) (F:PreDilCent X) (γ δ : F.cov.J)
  [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))] :
    Scheme.Hom.IsOver (Dil_loc_pair_swap X F γ δ) (open_pair X F γ δ) :=
  Classical.choose_spec (Dil_loc_pair_lemm X F γ δ) |>.1.1

lemma Dil_loc_pair_swap_restrict (X: Scheme) (F:PreDilCent X) (γ δ : F.cov.J)
  [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))]
  (C : CommRingCat) (i : Spec C ⟶ open_pair X F γ δ) [IsOpenImmersion i] :
    restrictToOpen (Dil_loc_pair_swap X F γ δ) i =
    (pullbackSymmetry _ _).hom ≫ Dil__loc_pair_open_φ X F γ δ C i ≫
    (pullbackSymmetry _ _).hom :=
  Classical.choose_spec (Dil_loc_pair_lemm X F γ δ) |>.1.2 C i

lemma Dil_loc_pair_swap_uniq (X: Scheme) (F: PreClos X) (γ δ : F.cov.J)
  [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))]
  (f : Dil__loc_pair X F γ δ ⟶ Dil__loc_pair X F δ γ)
  (is_over : Scheme.Hom.IsOver f (open_pair X F γ δ))
  (affine : ∀ (C : CommRingCat) (i : Spec C ⟶ open_pair X F γ δ) [IsOpenImmersion i],
    restrictToOpen f i =
    (pullbackSymmetry _ _).hom ≫ Dil_loc_pair_open_φ X F γ δ C i ≫
    (pullbackSymmetry _ _).hom) :
    f = Dil_loc_pair_swap X F γ δ :=
  Classical.choose_spec (Dil_loc_pair_lemm X F γ δ) |>.2 f ⟨is_over, affine⟩

