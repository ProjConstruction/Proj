def PreDilGlob  (F:PreDilCent X) [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))] : Scheme.GlueData where
  J := F.cov.J
  U γ := Dil_loc X F γ
  V pair := Dil_loc_pair X F pair.1 pair.2
  f γ δ := pullback.snd _ _
  f_mono γ δ := inferInstance
  f_hasPullback := inferInstance
  f_id i := by infer_instance
  t γ δ := Dil_loc_pair_swap X F γ δ
  t_id i := by
    dsimp
    symm
    apply Dil__loc_pair_swap_uniq
    · sorry
    · sorry
  t' i j k := sorry
  t_fac := sorry
  cocycle := sorry
  f_open := inferInstance

abbrev DilGlob (F:PreDilCent X) [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))] : Scheme :=
  Scheme.GlueData.glued (PreDilGlob F)

instance (F:PreDilCent X) [DecidableEq F.indnumb]
  [(i : F.indnumb →₀ ℤ) → Decidable (i ∈ Set.range (ρNatToInt F.indnumb))] :
  Scheme.Over (DilGlob F) X where
  hom := Multicoequalizer.desc _ _
    (fun γ : F.cov.J => Dil_loc X F γ ↘ X) <| by
    rintro ⟨γ, δ⟩
    simp only [MultispanShape.prod_L, GlueData.diagram_left, MultispanShape.prod_fst,
      GlueData.diagram_right,
      MultispanShape.prod_snd] at γ ⊢
    change pullback.snd _ _ ≫ _ = (Dil_loc_pair_swap X F γ δ ≫ pullback.snd _ _) ≫ _
    simp only [Category.assoc]
    sorry



